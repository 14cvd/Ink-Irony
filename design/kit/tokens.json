{
  "name": "InkDesignSystem",
  "version": "2.0.0-draft",
  "color": {
    "paper":       { "light": "#F7F0E3", "dark": "#1F2B27", "role": "screen ground" },
    "sheet":       { "light": "#FFFDF7", "dark": "#26352F", "role": "cards, keys" },
    "desk":        { "light": "#EFE5D2", "dark": "#17211E", "role": "tab bar, behind exam paper" },
    "ink":         { "light": "#1F2A44", "dark": "#EDEAE2", "role": "text, borders, primary button" },
    "onInk":       { "light": "#F7F0E3", "dark": "#1F2B27", "role": "text on primary button" },
    "primaryFill": { "light": "#1F2A44", "dark": "#F4D35E", "role": "primary button fill" },
    "teacher":     { "light": "#C2362F", "dark": "#FF8A7A", "role": "teacher voice, inked gallows, wrong" },
    "correct":     { "light": "#2C7A51", "dark": "#7FD8A6", "role": "correct letters and keys, passed" },
    "reward":      { "light": "#FFE45C", "dark": "#F4D35E", "role": "highlighter, combo, current node" },
    "inkDrop":     { "light": "#2F5DA8", "dark": "#9CC8FF", "role": "currency, hints" },
    "secondary":   { "light": "#5E5A54", "dark": "#A9B3AE", "role": "captions, metadata" },
    "ghost":       { "light": "#9A948A", "dark": "#6F7D77", "role": "remaining lives (dashed), locked" },
    "ruledLine":   { "light": "rgba(47,93,168,0.16)", "dark": "rgba(237,234,226,0.05)", "role": "notebook lines" },
    "marginLine":  { "light": "rgba(224,107,95,0.55)", "dark": "rgba(255,138,122,0.25)", "role": "red margin" }
  },
  "contrast": {
    "ink/paper": 12.58, "teacher/paper": 4.8, "correct/paper": 4.62, "secondary/paper": 6.04, "inkDrop/paper": 5.7,
    "ink/paper.dark": 12.19, "teacher/paper.dark": 6.4, "correct/paper.dark": 8.57, "secondary/paper.dark": 6.8, "reward/paper.dark": 10.0
  },
  "font": {
    "display":  { "family": "Caveat", "weight": 700, "license": "OFL-1.1" },
    "voice":    { "family": "Special Elite", "weight": 400, "license": "Apache-2.0", "note": "teacher lines only; Latin only, ru needs a fallback" },
    "ui":       { "family": "Courier Prime", "weights": [400, 700], "license": "OFL-1.1" }
  },
  "type": {
    "wordSlot":   { "font": "display", "size": 42, "textStyle": "largeTitle" },
    "title":      { "font": "display", "size": 34, "textStyle": "title" },
    "button":     { "font": "display", "size": 28, "textStyle": "title2" },
    "tile":       { "font": "display", "size": 24, "textStyle": "title3" },
    "teacher":    { "font": "voice",   "size": 15, "textStyle": "body" },
    "body":       { "font": "ui",      "size": 14, "textStyle": "callout" },
    "caption":    { "font": "ui",      "size": 12, "textStyle": "caption" },
    "overline":   { "font": "ui",      "size": 12, "weight": 700, "tracking": 2, "textStyle": "caption" }
  },
  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 20, "xxl": 32, "screenMargin": 20, "marginLineX": 28 },
  "radius": { "key": 9, "chip": 12, "button": 14, "card": 18, "pill": 999 },
  "stroke": { "hair": 1.5, "border": 2, "doodle": 2.6, "gallows": 3 },
  "shadow": { "card": { "x": 4, "y": 4, "blur": 0, "color": "ink" }, "button": { "x": 3, "y": 3, "blur": 0, "color": "teacher" }, "key": { "x": 0, "y": 3, "blur": 0, "color": "ink" } },
  "size": { "minTarget": 44, "keyHeight": 52, "keyMinWidth": 29, "keyGap": 5, "primaryButton": 56, "tabBar": 84 },
  "motion": {
    "gallowsInk":  { "ms": 450, "curve": "cubic-bezier(0.2,0.8,0.2,1)", "reduced": "fade 150" },
    "doodleFace":  { "ms": 220, "spring": { "response": 0.35, "damping": 0.6 }, "reduced": "instant" },
    "letterIn":    { "ms": 300, "stagger": 60, "spring": { "response": 0.4, "damping": 0.7 }, "reduced": "opacity" },
    "combo":       { "ms": 260, "curve": "pop 1.25 to 1", "reduced": "static" },
    "bubble":      { "ms": 350, "spring": { "response": 0.45, "damping": 0.7 }, "reduced": "crossfade 150" },
    "escape":      { "ms": 1200, "spring": { "response": 0.6, "damping": 0.55 }, "reduced": "smile only" },
    "booksTumble": { "ms": 700, "curve": "easeIn", "reduced": "static tilt" },
    "gradeStamp":  { "ms": 180, "shake": { "ms": 120, "pt": 2 }, "reduced": "fade 150" }
  }
}
